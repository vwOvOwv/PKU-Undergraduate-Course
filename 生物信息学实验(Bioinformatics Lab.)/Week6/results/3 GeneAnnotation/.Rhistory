EnhancedVolcano(res, x = res$log2FoldChange, y = -log(res$padj, base = 10))
EnhancedVolcano(res,
lab = rownames(res),
x = 'log2FoldChange',
y = 'pvalue')
which.min(res$padj)
plotCounts(dds, gene = which.min(res$padj), intgroup = "condition")
